{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=server.cjs",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs server.js *.map",
    "lint": "tsc --noEmit",
    "cap:build": "npm run build && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:sha": "node scripts/get-sha.js",
    "migrate:r2": "node scripts/migrate-from-r2.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.18.0",
    "sanitize-html": "^2.18.1",
    "vite": "^6.2.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
