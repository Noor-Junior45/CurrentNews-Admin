{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.gsd-path/guard_hook.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.gsd-path/guard_hook.py\" 2>/dev/null || exit 2"
          }
        ]
      }
    ]
  }
}
